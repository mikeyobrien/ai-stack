# Machine-specific configuration for ai-stack (12-factor).
# Copy to .env (gitignored) or export in your shell before running ./install.sh.

# --- DSH ---
# SPARKS_API_KEY=
# DSH_SPARKS_BASE_URL=http://127.0.0.1:8888/v1
# DSH_VOICE_STT_URL=http://127.0.0.1:8891/v1/audio/transcriptions

# --- pi providers (unset optional providers are omitted from models.json) ---
# PI_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# PI_SPARKS_BASE_URL=http://your-sparks-host:8888/v1
# PI_SPARKS_API_KEY=local
# PI_REEF_BASE_URL=http://your-reef-host:8010/v1
# PI_STRATA_BASE_URL=http://your-strata-host:8011/v1

# --- pi defaults (override pi/settings.json at install time) ---
# PI_DEFAULT_PROVIDER=ollama
# PI_DEFAULT_MODEL=glm-5.3-flash:cloud

# --- sparks-lanes.ts runtime overrides (optional) ---
# PI_SPARKS_PROVIDER=sparks
# PI_STRATA_PROVIDER=reef-strata
# PI_SPARKS_LANES=4
# PI_STRATA_LANES=4
