{
  "name": "@local/dsh-client-sidebar-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A phone-width sidebar: the rail becomes a drawer with a scrim that closes on outside tap or Escape, and the navigation rows get touch-sized targets.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/"
  }
}
