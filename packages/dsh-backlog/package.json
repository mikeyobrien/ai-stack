{
  "name": "@local/dsh-backlog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Park ideas without interrupting; explicitly pull them into a draft later.",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json" },
  "files": ["index.js", "store.js", "client.js", "cordis.patch.yml", "locale", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation"] }
  },
  "scripts": { "test": "node --test test/*.test.js" }
}
